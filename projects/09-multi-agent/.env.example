# Multi-Agent Systems - Environment Variables
# Copy this file to .env and fill in your values

# LLM API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Multi-Agent Configuration
MAX_AGENTS=10
COORDINATOR_MODEL=gpt-4
WORKER_MODEL=gpt-3.5-turbo
MAX_ROUNDS=5

# Communication
MESSAGE_QUEUE_TYPE=memory
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=INFO
DEBUG=true
TRACE_AGENTS=true

# Database
DATABASE_URL=sqlite:///multi_agent.db
