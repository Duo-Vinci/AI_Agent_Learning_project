# =============================================================================
# DeepSeek API 配置（主要使用）
# =============================================================================
# DeepSeek API 密钥（必填）- 用于 LLM 对话
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek API 地址（可选，默认值如下）
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# DeepSeek 模型名称（可选，默认值：deepseek-v4-flash）
DEEPSEEK_MODEL=deepseek-v4-flash

# =============================================================================
# OpenAI API 配置（用于 Embeddings 向量化）
# =============================================================================
# 注意：DeepSeek 不支持 Embeddings 接口，需要使用 OpenAI 的免费额度
# text-embedding-ada-002 有免费额度（约$5）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# Ollama 本地模型配置（备选）
# =============================================================================
# 如果你没有 OpenAI API Key，可以使用 Ollama 本地部署
# 安装命令：ollama pull nomic-embed-text
# OLLAMA_BASE_URL=http://localhost:11434
